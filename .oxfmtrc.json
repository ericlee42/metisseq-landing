{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/*-min.js",
    "**/*.min.js",
    "dist-ssr/",
    "dist/",
    "node_modules/**",
    "package-lock.json",
    "src/configs/abi/**",
    ".github/**"
  ]
}
