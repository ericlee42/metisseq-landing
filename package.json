    "@vitejs/plugin-react-swc": "^4.3.3",
    "jsdom": "^30.1.1",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "terser": "^5.51.2",
    "typescript": "7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-virtual-mpa": "^1.12.1",
    "vitest": "^5.0.3"
  },
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": "^24.15.0 || >=26.0.0",
    "npm": ">=11"
