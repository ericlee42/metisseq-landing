{
  "name": "metis-seq-web",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "start": "vite --open --host",
    "start:prod": "vite --open --host --mode production",
    "build": "vite build --mode production",
    "build:qa": "vite build --mode test",
    "preview": "vite preview",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint:fix": "oxlint --fix .",
    "format:check": "oxfmt --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "ahooks": "3.10.0",
    "classnames": "^2.5.1",
    "copy-to-clipboard": "^4.0.2",
    "dayjs": "^1.11.23",
    "framer-motion": "^14.0.0",
    "hamburger-react": "^2.5.2",
    "jotai": "3.0.1",
    "mac-scrollbar": "^0.13.8",
    "nprogress": "^0.2.0",
    "react": "19.3.0",
    "react-burger-menu": "^3.1.0",
    "react-dom": "19.3.0",
    "react-remove-scroll": "2.7.2",
    "react-router-dom": "^7.18.4",
    "styled-components": "^6.5.3",
    "viem": "2.57.2",
    "wagmi": "3.7.7"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
